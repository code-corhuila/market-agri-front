# Copy to .env (never versioned). Only the container knows where the gateway is (Annex H, rule 3).
# Public base of the API contract §1; empty = same origin as the page.
VITE_GATEWAY_URL=http://localhost:8080

# Where each portal publishes its remoteEntry.js (Module Federation, ADR-021). Fixed at build time.
VITE_AUTH_PORTAL_URL=http://localhost:5174/remoteEntry.js
VITE_CATALOG_PORTAL_URL=http://localhost:5175/remoteEntry.js
VITE_TRANSACTIONS_PORTAL_URL=http://localhost:5176/remoteEntry.js
