# LF in the repository and in the working tree, on every OS (G-5): Prettier and the CI expect it.
* text=auto eol=lf

# Generated by npm: GitHub collapses it in the diff and leaves it out of the language stats, so
# the 400-line review cap (Norma 9.2) is measured on the code that was written by hand.
package-lock.json linguist-generated=true
